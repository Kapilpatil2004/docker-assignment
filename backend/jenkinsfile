
pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    environment {
        APP_HOST = '172.31.7.46'
        SSH_CREDENTIAL = 'app-ec2-ssh'
        APP_DIR = '/home/ubuntu/docker-assignment'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Validate Flask files') {
            steps {
                sh '''
                    test -f backend/app.py
                    test -f backend/requirements.txt
                    python3 --version
                '''
            }
        }

        stage('Deploy Flask') {
            steps {
                sshagent(credentials: [SSH_CREDENTIAL]) {
                    sh '''
                        ssh -o StrictHostKeyChecking=accept-new ubuntu@$APP_HOST \
                          'cd /home/ubuntu/docker-assignment && git pull --ff-only origin main'

                        ssh ubuntu@$APP_HOST \
                          'cd /home/ubuntu/docker-assignment/backend && ./venv/bin/pip install -r requirements.txt && sudo -n systemctl restart flask-backend && sudo -n systemctl is-active flask-backend'
                    '''
                }
            }
        }
    }

    post {
        success {
            echo 'Flask deployment completed successfully.'
        }
        failure {
            echo 'Flask deployment failed. Check the console output.'
        }
    }
}
